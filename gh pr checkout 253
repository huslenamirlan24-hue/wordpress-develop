#!/usr/bin/env bash
# Clone the repo (if needed) and checkout PR 253 using GitHub CLI.
set -euo pipefail

repo="git@github.com:jschanker/text2code.git"
pr=253
dir="$(basename "${repo}" .git)"

command -v git >/dev/null 2>&1 || { echo "git not found in PATH"; exit 1; }
command -v gh >/dev/null 2>&1 || { echo "gh (GitHub CLI) not found in PATH"; exit 1; }

if [ -d "$dir" ]; then
    echo "Using existing directory: $dir"
    cd "$dir"
    git fetch origin --prune
else
    git clone "$repo" "$dir"
    cd "$dir"
fi

if ! gh auth status >/dev/null 2>&1; then
    echo "GitHub CLI not authenticated. Run: gh auth login"
    exit 1
fi

echo "Checking out PR #$pr"
gh pr checkout "$pr"